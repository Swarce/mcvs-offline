<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the EMBED group (owner: EMBED): the platform-independent parts of hosts/embedded (compiled in here for
    net8, without MCVS_EMBEDDED) and the patcher. Patch locators are exercised on Roslyn-compiled look-alikes of the
    game code (run before and after patching) and, when available, on the player's real assemblies/APK
    (MCVS_REFS, MCVS_APK). Signing is checked with apksigner when Android build-tools are found (MCVS_BUILD_TOOLS,
    PATH or ANDROID_HOME).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>McvsOffline.Embed.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../server/McvsOffline.Server.csproj" />
    <ProjectReference Include="../../patcher/McvsOffline.Patcher.csproj" />
    <ProjectReference Include="../../tools/hd-textures/McvsOffline.HdTextures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embedded host's portable code (Android-only files are behind #if MCVS_EMBEDDED). -->
    <Compile Include="../../hosts/embedded/**/*.cs" LinkBase="Embedded" />
  </ItemGroup>
</Project>

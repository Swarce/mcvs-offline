<Project Sdk="Microsoft.NET.Sdk">
  <!--
    McvsOffline.Patcher (owner: EMBED): turns the player's own APK into the offline APK
    (ARCHITECTURE §2.3, verify-C7 §7). Never ships or downloads Gameloft binaries.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>McvsOffline.Patcher</AssemblyName>
    <RootNamespace>McvsOffline.Patcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McvsOffline.Embed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The project's own launcher icon and launch-screen art (art/android/README.md), built in so players keep running the
      same command: with no art files here, the patcher keeps the stock icon and splash. Documentation and examples are not
      art (Art/ArtSource.cs ignores them too).
    -->
    <EmbeddedResource Include="../art/android/**" Exclude="../art/android/**/README*;../art/android/**/*.md;../art/android/**/*.example.json;../art/android/**/.*"
                      LogicalName="art/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

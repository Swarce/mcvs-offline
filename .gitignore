# Build outputs (everything builds into artifacts/)
artifacts/
bin/
obj/
TestResults/
*.user
*.suo
.vs/
.idea/
.vscode/

# Runtime data of a local standalone host (settings, accounts, profiles, logs)
/data/
*.log
*.jsonl

# Never commit Gameloft binaries, game data, decompiled sources or anything derived from them.
# (Generated item ids/prices in server/Content are the only exception.)
*.apk
*.aab
*.obb
*.amz
*.dll
*.so
*.pdb
*.dex
*.f
# HD texture packs (tools/hd-textures): converted from the player's own game files.
# The ASTC data pack holds Gameloft's whole files/ tree; pack.info and replaced.tsv are its installer index and list.
mcvs-hd-*.zip
mcvs-hd-*.zip.partial
mcvs-astc-hd-*.zip
mcvs-astc-hd-*.zip.partial
pack.info
replaced.tsv
*.ktx
*.game
*.tx
*.level
*.xlsx
extracted/
decompiled/
decompiled-java/
datapack/
datapack-decoded/
captures/

# Python tool caches (tools/content-gen)
__pycache__/
*.pyc

# Signing keys: the patcher creates the player's private key in the user profile (.../McvsOffline/) or at --keystore
*.p12
*.pfx
*.jks
*.keystore

# Art previews of tools/art/export-icons.py (never committed: they may show work in progress)
art/previews/

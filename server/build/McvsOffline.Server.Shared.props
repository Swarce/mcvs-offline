<Project>
  <!--
    Shared by McvsOffline.Server.csproj (net8.0) and McvsOffline.Server.Embedded.csproj (game Mono BCL).
    Both builds compile exactly the same sources: server/Core/** and server/Services/**.

    server/Content/** is compiled INTO the assembly as generated C# (BuiltInContent), not as manifest
    resources: the game's trimmed mscorlib has no Assembly.GetManifestResourceStream, and the embedded
    build must stay a single DLL. Text files (.json/.txt/.csv/.tsv) become string literals, anything else
    base64. *.md files are documentation and are skipped. See server/Content/README.md.
  -->
  <PropertyGroup>
    <AssemblyName>McvsOffline.Server</AssemblyName>
    <RootNamespace>McvsOffline.Server</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <McvsServerDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</McvsServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(McvsServerDir)Core/**/*.cs" />
    <Compile Include="$(McvsServerDir)Services/**/*.cs" />
    <McvsContent Include="$(McvsServerDir)Content/**/*" Exclude="$(McvsServerDir)Content/**/*.md" />
  </ItemGroup>

  <UsingTask TaskName="McvsGenerateContentSource"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <ContentRoot ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string root = Path.GetFullPath(ContentRoot).TrimEnd('/', '\\') + Path.DirectorySeparatorChar;
        var paths = new List<string>();
        if (Files != null)
            foreach (var item in Files) paths.Add(Path.GetFullPath(item.GetMetadata("FullPath")));
        paths.Sort(StringComparer.Ordinal);

        var sb = new StringBuilder();
        sb.Append("// <auto-generated>\n// Generated at build time from server/Content by server/build/McvsOffline.Server.Shared.props.\n// Do not edit; change the files in server/Content instead.\n// </auto-generated>\n");
        sb.Append("namespace McvsOffline.Server.Core.Content\n{\n    internal static partial class BuiltInContent\n    {\n");
        if (paths.Count > 0)
        {
            sb.Append("        static partial void Register(System.Collections.Generic.Dictionary<string, string> text, System.Collections.Generic.Dictionary<string, string> base64)\n        {\n");
            foreach (string full in paths)
            {
                string rel = full.StartsWith(root, StringComparison.Ordinal) ? full.Substring(root.Length) : Path.GetFileName(full);
                rel = rel.Replace('\\', '/');
                byte[] bytes = File.ReadAllBytes(full);
                string ext = Path.GetExtension(full).ToLowerInvariant();
                bool isText = ext == ".json" || ext == ".txt" || ext == ".csv" || ext == ".tsv";
                string literal;
                if (isText)
                {
                    string s = new UTF8Encoding(false, true).GetString(bytes);
                    if (s.Length > 0 && s[0] == '\uFEFF') s = s.Substring(1);
                    var lit = new StringBuilder(s.Length + 16);
                    foreach (char c in s)
                    {
                        if (c == '\\') lit.Append("\\\\");
                        else if (c == '"') lit.Append("\\\"");
                        else if (c == '\n') lit.Append("\\n");
                        else if (c == '\r') lit.Append("\\r");
                        else if (c == '\t') lit.Append("\\t");
                        else if (c < 0x20 || c > 0x7E) lit.Append("\\u").Append(((int)c).ToString("x4"));
                        else lit.Append(c);
                    }
                    literal = lit.ToString();
                }
                else
                {
                    literal = Convert.ToBase64String(bytes);
                }
                sb.Append("            ").Append(isText ? "text" : "base64").Append("[\"").Append(rel.Replace("\\", "\\\\").Replace("\"", "\\\"")).Append("\"] = \"").Append(literal).Append("\";\n");
            }
            sb.Append("        }\n");
        }
        sb.Append("    }\n}\n");

        string code = sb.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != code)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(OutputFile)));
            File.WriteAllText(OutputFile, code);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Always regenerates (cheap) but only rewrites the file when it changed, so CoreCompile stays incremental. -->
  <Target Name="McvsGenerateContent" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <McvsContentSourceFile>$(IntermediateOutputPath)McvsContent.g.cs</McvsContentSourceFile>
    </PropertyGroup>
    <McvsGenerateContentSource Files="@(McvsContent)" ContentRoot="$(McvsServerDir)Content" OutputFile="$(McvsContentSourceFile)" />
    <ItemGroup>
      <Compile Include="$(McvsContentSourceFile)" />
      <FileWrites Include="$(McvsContentSourceFile)" />
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    McvsOffline.HdTextures (owner: EMBED): the desktop side of the HD texture work (docs/research/pc-textures.md).
    Today: "probe", which builds the WP1 device-probe zip from the player's own data pack (one recoloured texture under
    each naming the engine might use). Runs on the player's computer; never ships or downloads game data.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>McvsOffline.HdTextures</AssemblyName>
    <RootNamespace>McvsOffline.Tools.HdTextures</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- DataPack (hashed names, GCBF decoding) and Crc32 of the server library. -->
    <ProjectReference Include="../../server/McvsOffline.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McvsOffline.Embed.Tests" />
  </ItemGroup>
</Project>

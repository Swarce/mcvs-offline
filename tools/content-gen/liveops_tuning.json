      {"id": "override", "name": "Arena.Override", "rule": "Arena.OverrideDesc", "matchType": "ControlPoint", "parameterSets": ["ArenaOverride"]},
      {"id": "ambush", "name": "Arena.Ambush", "rule": "Arena.AmbushDesc", "matchType": "Dominion", "parameterSets": ["ArenaAmbush"]},
      {"id": "grandBounty", "name": "Arena.GrandBounty", "rule": "Arena.GrandBountyDesc", "matchType": "Uphold", "parameterSets": ["ArenaGrandBounty"]},
      {"id": "bountiful", "name": "Arena.Bountiful", "rule": "Arena.BountifulDesc", "matchType": "Uphold", "parameterSets": ["ArenaBountiful"]},
      {"id": "blitzTDM", "name": "Arena.BlitzTDM", "rule": "Arena.BlitzTDMDesc", "matchType": "TeamDeathMatch", "parameterSets": ["ArenaBlitz"]},
      {"id": "blitzZoneControl", "name": "Arena.BlitzZoneControl", "rule": "Arena.BlitzZoneControlDesc", "matchType": "ControlPoint", "parameterSets": ["ArenaBlitz"]},
      {"id": "blitzWarzone", "name": "Arena.BlitzWarzone", "rule": "Arena.BlitzWarzoneDesc", "matchType": "Dominion", "parameterSets": ["ArenaBlitz"]},
      {"id": "blitzBounty", "name": "Arena.BlitzBounty", "rule": "Arena.BlitzBountyDesc", "matchType": "Uphold", "parameterSets": ["ArenaBlitz"]},
      {"id": "scorechargeTDM", "name": "Arena.ScorechargeTDM", "rule": "Arena.ScorechargeTDMDesc", "matchType": "TeamDeathMatch", "parameterSets": ["ArenaScorechargeTDM"]},
      {"id": "scorechargeZoneControl", "name": "Arena.ScorechargeZoneControl", "rule": "Arena.ScorechargeZoneControlDesc", "matchType": "ControlPoint", "parameterSets": ["ArenaScorechargeZoneControl"]},
      {"id": "scorechargeWarzone", "name": "Arena.ScorechargeWarzone", "rule": "Arena.ScorechargeWarzoneDesc", "matchType": "Dominion", "parameterSets": ["ArenaScorechargeWarzone"]},
      {"id": "scorechargeBounty", "name": "Arena.ScorechargeBounty", "rule": "Arena.ScorechargeBountyDesc", "matchType": "Uphold", "parameterSets": ["ArenaScorechargeBounty"]},
      {"id": "competitiveTDM", "name": "Arena.CompetitiveTDM", "rule": "Arena.CompetitiveTDMDesc", "matchType": "TeamDeathMatch", "parameterSets": ["Arena3RoundSystem"], "allowDuplicates": false, "multipliers": {"creditsVictory": 1.5, "versusCoinsVictory": 1.5}},
      {"id": "competitiveZoneControl", "name": "Arena.CompetitiveZoneControl", "rule": "Arena.CompetitiveZoneControlDesc", "matchType": "ControlPoint", "parameterSets": ["Arena3RoundSystem"], "allowDuplicates": false, "multipliers": {"creditsVictory": 1.5, "versusCoinsVictory": 1.5}},
      {"id": "competitiveWarzone", "name": "Arena.CompetitiveWarzone", "rule": "Arena.CompetitiveWarzoneDesc", "matchType": "Dominion", "parameterSets": ["Arena3RoundSystem"], "allowDuplicates": false, "multipliers": {"creditsVictory": 1.5, "versusCoinsVictory": 1.5}},
      {"id": "competitiveBounty", "name": "Arena.CompetitiveBounty", "rule": "Arena.CompetitiveBountyDesc", "matchType": "Uphold", "parameterSets": ["Arena3RoundSystem"], "allowDuplicates": false, "multipliers": {"creditsVictory": 1.5, "versusCoinsVictory": 1.5}},
      {"id": "competitiveRegular", "name": "Arena.CompetitiveRegular", "rule": "Arena.CompetitiveRegularDesc", "matchType": "None", "parameterSets": ["Arena3RoundSystem"], "allowDuplicates": false, "multipliers": {"creditsVictory": 1.5, "versusCoinsVictory": 1.5}},
      {"id": "tdm", "name": "Arena.TDM", "rule": "Arena.TDMDesc", "matchType": "TeamDeathMatch"},

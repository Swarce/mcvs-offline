      "Uphold": {"text": "HUD.GameModeUphold", "img": "Menus/assets/png/tournament/mode_uphold.png"},
      "Dominion": {"text": "HUD.Dominion", "img": "Menus/assets/png/tournament/mode_dominion.png"},
      "None": {"text": "Arena.CompetitiveArena", "img": "Menus/assets/png/tournament/mode_random.png"}
    },
    "modes": [

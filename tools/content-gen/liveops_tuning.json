{
  "_comment": [
    "MCVS Offline live-ops tuning (our own numbers, not Gameloft's). tools/content-gen/content_gen.py validates this",
    "against the player's decoded catalogue (crates, design-table fields, loc tables, image assets) and writes",
    "server/Content/liveops.json. Design and settings: docs/LIVEOPS.md. Text is never copied: titles are the game's",
    "own localization ids (<table>.<id>, e.g. menu.Tle01Name from Localization/menu_<lang>.json).",
    "Bump 'revision' when a change must replace events players already hold (it is part of every event's _version).",
    "'collector': the Cosmetic crates added to the daily bonus, the day's first mission, each weekly milestone tier and",
    "the weekly final in every window from 'since' on (docs/design/economy-collector.md section 3). One crate per",
    "milestone: the claim reveals only a milestone's last crate, so the crate goes only where today's milestone holds",
    "none (not the daily bonus with its Contracts crate, not the weekly final with its event crate). Do not bump",
    "'revision' for it: set 'since' to the first Monday 00:00 UTC at least 7 days after the build is published",
    "(content-gen warns otherwise)."
  ],
  "revision": 1,
  "images": {
    "weeklyBanner": "Menus/assets/png/tournament/mode_all.png",
    "weeklyMenu": "Menus/assets/png/tournament/tournamentLogo.png",
    "dailyBanner": "Menus/assets/png/tournament/modeBg.png",
    "dailyMenu": "Menus/assets/png/tournament/mode_random.png"
  },
  "seasons": {
    "title": "menu.DivisionTitle",
    "description": "menu.DivisionsDescriptionText",
    "_promotionMatchesPerDay": "per division (1..17): matches per season day, at a 50% win rate, that the rival at the promotion line plays (Master: the 10th rival)",
    "promotionMatchesPerDay": [2, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 10, 11, 12],
    "topFactor": 2.2,
    "safeFraction": 0.15,
    "masterTopRank": 10,
    "defaultLevel": 10,
    "fallbackZones": {"promotion": 20, "demotion": 10}
  },
  "objectives": [
    {"id": "matches", "tracker": "PlayedMatches", "title": "Achiev.AchievementPVPBattleObjective",
     "titlePlural": "Achiev.AchievementPVPBattleObjective",
     "daily": {"goals": [3, 4, 5], "rewards": [{"item": "VersusCoins", "quantity": 150}, {"item": "Credits", "quantity": 10}]},
     "weekly": {"goals": [10, 25, 50]}},
    {"id": "wins", "tracker": "Wins", "title": "menu.NumberWinsSingle", "titlePlural": "menu.NumberWins",
     "theme": {"title": "menu.Tle02Name", "description": "menu.TleWinDescription"},

     "weekly": {"goals": [5, 15, 30]}},
    {"id": "kills", "tracker": "Kills", "title": "menu.NumberTakedownsSingle", "titlePlural": "menu.NumberTakedowns",
     "theme": {"title": "menu.TleTitle", "description": "menu.TleKillsDescription"},
     "daily": {"goals": [15, 20, 25], "rewards": [{"item": "VersusCoins", "quantity": 150}, {"item": "Credits", "quantity": 10}]},
     "weekly": {"goals": [50, 150, 300]}},
    {"id": "eliminations", "tracker": "Eliminations", "title": "menu.NumberEliminatedSingle", "titlePlural": "menu.NumberEliminated",
     "theme": {"title": "menu.Tle01Name", "description": "menu.Tle01Description"},
     "daily": {"goals": [20, 30, 40], "rewards": [{"item": "VersusCoins", "quantity": 150}, {"item": "Credits", "quantity": 10}]},
     "weekly": {"goals": [75, 200, 400]}},
    {"id": "assists", "tracker": "Assists", "title": "Achiev.AchievementAssitsDescription", "titlePlural": "Achiev.AchievementAssitsDescription",
     "theme": {"title": "menu.Tle05Name", "description": "menu.AssistsDescription"},
     "daily": {"goals": [8, 12, 15], "rewards": [{"item": "VersusCoins", "quantity": 150}, {"item": "Credits", "quantity": 10}]},
     "weekly": {"goals": [30, 80, 160]}},
    {"id": "mvp", "tracker": "MVP", "title": "Achiev.MVPObjective", "titlePlural": "Achiev.MVPObjective",
     "daily": {"goals": [1], "rewards": [{"item": "VersusCoins", "quantity": 250}, {"item": "Credits", "quantity": 15}]},
     "weekly": {"goals": [2, 5, 10]}},
    {"id": "crates", "tracker": "CratesOpened", "title": "Achiev.AchievementCratesDescription", "titlePlural": "Achiev.AchievementCratesDescription",
     "weekly": {"goals": [2, 5, 10]}}
  ],
  "dailyQuests": {
    "title": "crm.DailyQuestTitle",
    "description": "crm.DailyQuestText",
    "advertisement": "menu.DailyQuest",
    "count": 3,
    "bonus": {"title": "menu.ContractsWords", "rewards": [{"item": "Crate_Contracts", "quantity": 1}]}
  },
  "weeklyEvents": {
    "advertisement": "menu.LimitedTimeEvent",
    "boostedTag": "menu.rewardsBoostedTitle",
    "count": 4,
    "themes": ["kills", "wins", "eliminations", "assists"],
    "milestoneRewards": [
      [{"item": "VersusCoins", "quantity": 300}, {"item": "Credits", "quantity": 20}],
      [{"item": "VersusCoins", "quantity": 600}, {"item": "UpgradeTokens", "quantity": 50}],
      [{"item": "VersusCoins", "quantity": 1000}, {"item": "UpgradeTokens", "quantity": 100}]
    ],
    "eventCratePrefix": "Crate_Event_",
    "final": {"title": "menu.LimitedTimeEvent", "rewards": [{"item": "HardCurrency", "quantity": 20}], "eventCrate": true}
  },
  "modifiers": {
    "rotation": ["standard", "coinRush", "trophyFever", "creditRush", "mvpBounty", "rivalSurge"],
    "definitions": [
      {"id": "standard", "cells": []},
      {"id": "coinRush", "cells": [
        {"table": "VersusCoinsMatchRewards", "index": "Division", "ids": "divisions",
         "fields": ["VictoryAmount", "DefeatAmount", "MVPAmount", "DailyCap"], "factor": 1.5}]},
      {"id": "creditRush", "cells": [
        {"table": "CreditsCurrencyMatchRewards", "index": "Division", "ids": "divisions",
         "fields": ["VictoryAmount", "DefeatAmount", "MVPAmount", "DailyCap"], "factor": 1.5}]},
      {"id": "trophyFever", "cells": [
        {"table": "PlayerLevelXP", "index": "Level", "ids": "levels", "fields": ["DivisionTrophiesBonus"], "factor": 1.5}]},
      {"id": "mvpBounty", "cells": [
        {"table": "VersusCoinsMatchRewards", "index": "Division", "ids": "divisions", "fields": ["MVPAmount"], "factor": 3},
        {"table": "CreditsCurrencyMatchRewards", "index": "Division", "ids": "divisions", "fields": ["MVPAmount"], "factor": 3}]},
      {"id": "rivalSurge", "rivalFactor": 1.2, "cells": [
        {"table": "VersusCoinsMatchRewards", "index": "Division", "ids": "divisions",
         "fields": ["VictoryAmount", "DefeatAmount", "MVPAmount", "DailyCap"], "factor": 1.25},
        {"table": "CreditsCurrencyMatchRewards", "index": "Division", "ids": "divisions",
         "fields": ["VictoryAmount", "DefeatAmount", "MVPAmount", "DailyCap"], "factor": 1.25}]}
    ]
  },
  "seasonRewards": {"table": "PVPDivisionRewards", "index": "Rank", "fieldPrefix": "Division"},
  "arena": {
    "_comment": ["Special Events (the Battle popup's Arena box, docs/LIVEOPS.md §9): one ArenaModeEvent per liveops.arenaHours window,",
                 "the mode picked by the rotation (or pinned with liveops.arenaRotation). name/rule are Arena loc ids, matchType a",
                 "Game.MatchType (None: the GS picks one per map), parameterSets MCVS_Gameplay rule tables. Every agent is allowed",
                 "(an explicit Merc_<id> list: the client throws on an empty, Any or MercClass_ list). Multipliers scale the match's",
                 "Credits and VersusCoins (victory, defeat, MVP) on top of the economy settings; the daily caps still apply."],
    "priority": 3,
    "agents": "all",
    "multipliers": {"creditsVictory": 1.25, "versusCoinsVictory": 1.25},
    "matchTypes": {
      "TeamDeathMatch": {"text": "HUD.GameModeTDM", "img": "Menus/assets/png/tournament/mode_team_deathmatch.png"},

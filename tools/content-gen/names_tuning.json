  "_styles": [
    "pattern: literal text and {tokens}: the part lists above, d2 (00-99), d3 (100-999), d4 (1000-9999), year, alias (9 digits).",
    "case: asis (the parts as written), lower, upper, camel (first letter lower). leet: 1-3 letters of the word parts (never a",
    "country code) become digits (a4 e3 i1 o0 s5 t7).",
    "weight: how often the style is drawn. A name the limits or the blocklist refuse is drawn again (the next attempt)."
  ],
  "styles": [
    {"id": "adjNoun", "pattern": "{adj}{noun}", "weight": 16},
    {"id": "adj_noun", "pattern": "{adj}_{noun}", "case": "lower", "weight": 6},
    {"id": "adjNounCamel", "pattern": "{adj}{noun}", "case": "camel", "weight": 3},
    {"id": "nounNoun", "pattern": "{noun}{noun}", "weight": 5},
    {"id": "noun_d2", "pattern": "{noun}{d2}", "weight": 1},
    {"id": "noun_d3", "pattern": "{noun}{d3}", "weight": 1},
    {"id": "noun_d4", "pattern": "{noun}{d4}", "weight": 1},
    {"id": "noun_year", "pattern": "{noun}{year}", "weight": 1},
    {"id": "leetAdjNoun", "pattern": "{adj}{noun}", "leet": true, "weight": 2},
    {"id": "handle", "pattern": "{handle}", "case": "lower", "weight": 1},
    {"id": "Handle", "pattern": "{handle}", "weight": 1},
    {"id": "handle_d2", "pattern": "{handle}{d2}", "weight": 1},
    {"id": "handle__d3", "pattern": "{handle}_{d3}", "case": "lower", "weight": 1},
    {"id": "SHORT_d2", "pattern": "{short}{d2}", "case": "upper", "weight": 1},
    {"id": "shortNoun", "pattern": "{short}{noun}", "weight": 3},
    {"id": "theNoun", "pattern": "The{noun}", "weight": 1},
    {"id": "theAdjNoun", "pattern": "The{adj}{noun}", "weight": 2},
    {"id": "prefixNoun", "pattern": "{prefix}{noun}", "weight": 3},
    {"id": "nounSuffix", "pattern": "{noun}{suffix}", "weight": 3},
    {"id": "mascot_country", "pattern": "{mascot}_{country}", "weight": 3},
    {"id": "leetMascot_country", "pattern": "{mascot}_{country}", "leet": true, "weight": 1},
    {"id": "foreign", "pattern": "{foreign}{d2}", "weight": 1},
    {"id": "foreign_d3", "pattern": "{foreign}_{d3}", "case": "lower", "weight": 1},
    {"id": "adjForeign", "pattern": "{adj}{foreign}", "weight": 2},
    {"id": "foreignSuffix", "pattern": "{foreign}{suffix}", "weight": 1},
    {"id": "foreign_country", "pattern": "{foreign}_{country}", "weight": 1},
    {"id": "adj.noun", "pattern": "{adj}.{noun}", "case": "lower", "weight": 1},
    {"id": "default", "pattern": "agent-{alias}", "weight": 2}
  ],
  "_blocklist": [
    "Checked on every name the server makes, on every curated name and on every two-part combination by content-gen. A name",
    "is normalised first: lower case, without _ . - (a curated name: without anything but letters and digits, accents",
    "dropped), digits read as letters (0 o, 1 i or l, 3 e, 4 a, 5 s, 7 t, $ s, @ a).",
    "substrings: refused anywhere in the normalised name (so only words that no harmless part contains).",
    "words: refused as a whole part, as the whole name, or spanning the join of two parts (short words that harmless words",
    "contain); in a curated name, as one of its words (split at spaces, signs and lower-to-upper case changes).",
    "digits: refused inside any run of digits. digitRuns: refused as a whole run of digits.",
    "Since build 29 brands, characters, streamers and celebrities are no longer listed (the owner allows them); slurs,",
    "profanity, sexual words, hate terms, numbers and symbols, extremist groups, politicians and politics, religion, drugs",
    "and real tragedies stay."
  ],
